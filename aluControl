library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity aluControl is
    port (
        -- Entradas
        aluOP      : in std_logic_vector(1 downto 0);  -- Da Control Unit principal
        funct7     : in std_logic;                     -- Bit 30 do funct7
        funct3     : in std_logic_vector(2 downto 0);  -- Campo funct3 da instrucao
        
        -- Saida
        aluControl_out: out std_logic_vector(2 downto 0)  -- Operacao para a ULA
    );
end entity aluControl;

architecture behavioral of aluControl is
begin
    process(aluOP, funct7, funct3)
    begin
        case aluOP is
            when "00" => 
                -- Load/Store: sempre ADD
                aluControl_out <= "000"; -- ADD
                
            when "01" => 
                -- Branch: sempre SUB para comparacao
                aluControl_out <= "001"; -- SUB
                
            when "10" => 
                -- Instrucoes tipo R: decodifica funct3 e funct7
                case funct3 is
                    when "000" =>
                        if funct7 = '1' then
                            aluControl_out <= "001"; -- SUB
                        else
                            aluControl_out <= "000"; -- ADD
                        end if;
                    when "111" => aluControl_out <= "010"; -- AND
                    when "110" => aluControl_out <= "011"; -- OR  
                    when "100" => aluControl_out <= "100"; -- XOR
                    when others => aluControl_out <= "000"; -- default
                end case;
                
            when others => -- Cobre "11" e qualquer outro valor
                -- Instrucoes tipo I: usa funct3
                case funct3 is
                    when "000" => aluControl_out <= "000"; -- ADDI
                    when "111" => aluControl_out <= "010"; -- ANDI
                    when "110" => aluControl_out <= "011"; -- ORI
                    when "100" => aluControl_out <= "100"; -- XORI
                    when others => aluControl_out <= "000"; -- default
                end case;
        end case;
    end process;
end architecture;
