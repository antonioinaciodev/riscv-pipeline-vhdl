set_global_assignment -name TOP_LEVEL_ENTITY pipeline_toplevel
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top

# --- Módulos RTL (ordem não importa para o Quartus, mas mantemos lógica) ---
set_global_assignment -name VHDL_FILE ../rtl/alu.vhd
set_global_assignment -name VHDL_FILE ../rtl/alu_control.vhd
set_global_assignment -name VHDL_FILE ../rtl/branch_condition_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/data_memory.vhd
set_global_assignment -name VHDL_FILE ../rtl/ex_mem_register.vhd
set_global_assignment -name VHDL_FILE ../rtl/forwarding_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/hazard_detection_unit.vhd
set_global_assignment -name VHDL_FILE ../rtl/id_ex_register.vhd
set_global_assignment -name VHDL_FILE ../rtl/if_id_register.vhd
set_global_assignment -name VHDL_FILE ../rtl/immediate_generator.vhd
set_global_assignment -name VHDL_FILE ../rtl/instruction_memory.vhd
set_global_assignment -name VHDL_FILE ../rtl/main_control.vhd
set_global_assignment -name VHDL_FILE ../rtl/mem_wb_register.vhd
set_global_assignment -name VHDL_FILE ../rtl/program_counter.vhd
set_global_assignment -name VHDL_FILE ../rtl/register_file.vhd

# --- Top level ---
set_global_assignment -name VHDL_FILE ../rtl/pipeline_toplevel.vhd

# --- Testbenches (para simulação no ModelSim/Questa) ---
set_global_assignment -name VHDL_FILE ../tb/alu_tb.vhd
set_global_assignment -name VHDL_FILE ../tb/pipeline_tb.vhd
set_global_assignment -name EDA_TEST_BENCH_FILE ../tb/pipeline_tb.vhd -section_id pipeline_tb
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id pipeline_tb
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME pipeline_tb -section_id pipeline_tb
set_global_assignment -name EDA_TEST_BENCH_NAME pipeline_tb -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_RUN_SIM_FOR "1000 ns" -section_id pipeline_tb
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name DEVICE 5CGXFC7C7F23C8
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top