library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity forwardingUnit is 
port (
	id_ex_registerR1: in std_logic_vector(4 downto 0);
	id_ex_registerR2: in std_logic_vector(4 downto 0);
	
	ex_mem_registerRD: in std_logic_vector(4 downto 0);
	mem_wb_registerRD: in std_logic_vector(4 downto 0);
	
	ex_mem_registerWrite: in std_logic;
	mem_wb_registerWrite: in std_logic;
	
	-- ex_mem_memRead: in std_logic
	

	forward_A: out std_logic_vector(1 downto 0);
	forward_B: out std_logic_vector(1 downto 0)
	

);

end entity forwardingUnit;


architecture behavioral of forwardingUnit is
begin
	process(id_ex_registerR1, id_ex_registerR2, ex_mem_registerRD, mem_wb_registerRD,
            ex_mem_registerWrite, mem_wb_registerWrite)
	begin

	if ex_mem_registerWrite = '1' and id_ex_registerR1=ex_mem_registerRD
	and ex_mem_registerRD /="00000" then
	forward_A<="01";
	
	elsif mem_wb_registerWrite = '1' and id_ex_registerR1=mem_wb_registerRD
	and mem_wb_registerRD /="00000"	then
	forward_A<="10";
	
	else
	forward_A<="00";
	end if;
	
	if ex_mem_registerWrite = '1' and id_ex_registerR2=ex_mem_registerRD 
	and ex_mem_registerRD /="00000"then
	forward_B<="01";
	
	elsif mem_wb_registerWrite = '1' and id_ex_registerR2=mem_wb_registerRD 
	and mem_wb_registerRD /= "00000" then
	forward_B<="10";
	
	else
	forward_B<="00";
	end if;

	end process;
end architecture behavioral;
